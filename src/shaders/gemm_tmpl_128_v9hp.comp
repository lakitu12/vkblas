#version 450
// GEMM bf16/fp16 v9hp-128: tile 128×128, BK=16, 256 线程 (16×16), 每线程 8×8 = 64 acc
// = v9h 的打包主循环: LDS 直接存 2B 半精度打包 (1 uint = 2 half), 主循环每条 b64 读 4 half
// 结论: 证伪 (与 v10h 同因, 2026-08-26 第二独立实现)
//   实测 (gfx803, 4096³): bf16 TT 3.72T < v9h 4.04T
//   虽然 b64 无冲突布局 (lx*4 bank {0,4,..28}×2 = 32 全唯一) 避免了 v10h 的 b128 冲突,
//   LDS 流量减半 (32→16 拍) 不兑现 → 证明墙=LDS 指令数×固定拍数+解包指令, 不是带宽:
//   v9h 8 ds + 64 FMA / v9hp 4 ds + 64 FMA + 16 解包, 实测 v9hp 慢 8.7% ≈ 解包指令增量。
// 保留原因: 与 v10h (b128 冲突版) 构成"2B 打包"假设的完整驳斥证据链。
// 布局: As/Bs uint[16][130] (128 half + 2 pad); 主循环 b64 @ lx*4+ii*2 (连续 8 half/线程)
// 写 C 与 v9h 相同 (f2h 打包, ldc 偶 && N 偶 由 host 保证)
// -D HALF_TYPE=1 (fp16) / 2 (bf16); -D TA/TB 同 v9h
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer A_buf { uint A[]; };
layout(set = 0, binding = 1) buffer B_buf { uint B[]; };
layout(set = 0, binding = 2) buffer C_buf { uint C[]; };

layout(push_constant) uniform Params {
    uint M, N, K;
    uint Mt, Nt, Kt;
    uint lda, ldb, ldc;
    uint batch_stride_a, batch_stride_b, batch_stride_c;
    float alpha, beta;
} p;

shared uint As[16][130];   // 128 half + 2 pad (uint 单位; 行步长 130 → bank +2)
shared uint Bs[16][130];

// ---- 半精度位操作 ----
float hx(uint u, uint hb) {
#if HALF_TYPE == 1
    return unpackHalf2x16(u)[hb];
#else
    return uintBitsToFloat(((u >> (hb * 16u)) & 0xFFFFu) << 16u);
#endif
}
uint f2h(float v) {
#if HALF_TYPE == 1
    return packHalf2x16(vec2(v, 0.0)) & 0xFFFFu;
#else
    uint u = floatBitsToUint(v);
    return ((u + 0x7FFFu + ((u >> 16) & 1u)) >> 16) & 0xFFFFu;   // RNE
#endif
}
// As[kk][mm] 写一个 half (半 uint 掩码写; mm 偶时整 uint 清零 → 无未初始化垃圾)
void put_as(uint kk, uint mm, float v) {
    if ((mm & 1u) == 0u) As[kk][mm >> 1] = f2h(v);
    else As[kk][mm >> 1] = (As[kk][mm >> 1] & 0xFFFFu) | (f2h(v) << 16u);
}
void put_bs(uint kk, uint nn, float v) {
    if ((nn & 1u) == 0u) Bs[kk][nn >> 1] = f2h(v);
    else Bs[kk][nn >> 1] = (Bs[kk][nn >> 1] & 0xFFFFu) | (f2h(v) << 16u);
}
// 单个 half 全局读 (无对齐要求)
float load1h(uint sel, uint e) {
    uint u = (sel == 0u ? A[e >> 1] : B[e >> 1]);
    return hx(u, e & 1u);
}
// 4 连续 half 全局读 → 2 uint (要求 e 偶, host 保证行内 4B 对齐)
uvec2 load4h(uint sel, uint e) {
    uint u0 = (sel == 0u ? A[e >> 1] : B[e >> 1]);
    uint u1 = (sel == 0u ? A[(e >> 1) + 1u] : B[(e >> 1) + 1u]);
    return uvec2(u0, u1);
}

void load_tile(uint kt) {
    uint base_k = kt * 16;
    uint b = gl_WorkGroupID.x / p.Mt;
    uint tgx = gl_WorkGroupID.x % p.Mt;
    uint base_m = tgx * 128;
    uint base_n = gl_WorkGroupID.y * 128;
    uint tid = gl_LocalInvocationID.y * 16 + gl_LocalInvocationID.x;
    uint aoff = b * p.batch_stride_a;
    uint boff = b * p.batch_stride_b;

    // A: 128×16 tile = 2048 half, tid<128 加载, 每线程 4 m × 4 k
    if (tid < 128) {
        uint m0 = (tid % 32) * 4;                 // half 序号, 4 对齐
        uint k0 = (tid / 32) * 4;
        uint am = base_m + m0;
        uint ak = base_k + k0;
#if TA == 1
        // A 是 (K×M): 每 k 行 m 连续 4 → 2 uint 整写
        for (int r = 0; r < 4; r++) {
            uint kk = ak + r;
            uint e = aoff + kk * p.lda + am;
            if (kk < p.K && am + 3 < p.M && (e & 1u) == 0u) {
                uvec2 u = load4h(0u, e);
                As[k0 + r][m0 >> 1] = u.x;        // half m0, m0+1
                As[k0 + r][(m0 >> 1) + 1] = u.y;  // half m0+2, m0+3
            } else {
                for (int c = 0; c < 4; c++) {
                    uint mm = am + uint(c);
                    put_as(kk, mm, (kk < p.K && mm < p.M) ? load1h(0u, aoff + kk * p.lda + mm) : 0.0);
                }
            }
        }
#else
        // A 是 (M×K): 每 m 行 k 连续 4, 但目标行 (k0+c) 各 1 half → put_as 掩码写
        for (int r = 0; r < 4; r++) {
            uint mm = am + r;
            uint e = aoff + mm * p.lda + ak;
            if (mm < p.M && ak + 3 < p.K && (e & 1u) == 0u) {
                uvec2 u = load4h(0u, e);
                put_as(k0 + 0, m0 + r, hx(u.x, 0u));
                put_as(k0 + 1, m0 + r, hx(u.x, 1u));
                put_as(k0 + 2, m0 + r, hx(u.y, 0u));
                put_as(k0 + 3, m0 + r, hx(u.y, 1u));
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = ak + uint(c);
                    put_as(kk, m0 + r, (mm < p.M && kk < p.K) ? load1h(0u, aoff + mm * p.lda + kk) : 0.0);
                }
            }
        }
#endif
    } else {
        // B: 16×128 tile = 2048 half, tid>=128, 每线程 4 n × 4 k
        uint t2 = tid - 128;
        uint n0 = (t2 % 32) * 4;
        uint k0 = (t2 / 32) * 4;
        uint bn = base_n + n0;
        uint bk = base_k + k0;
#if TB == 1
        // B (N×K): 每 n 行 k 连续 4, 目标行 (k0+c) 各 1 half → put_bs 掩码写
        for (int r = 0; r < 4; r++) {
            uint nn = bn + r;
            uint e = boff + nn * p.ldb + bk;
            if (nn < p.N && bk + 3 < p.K && (e & 1u) == 0u) {
                uvec2 u = load4h(1u, e);
                put_bs(k0 + 0, n0 + r, hx(u.x, 0u));
                put_bs(k0 + 1, n0 + r, hx(u.x, 1u));
                put_bs(k0 + 2, n0 + r, hx(u.y, 0u));
                put_bs(k0 + 3, n0 + r, hx(u.y, 1u));
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = bk + uint(c);
                    put_bs(kk, n0 + r, (nn < p.N && kk < p.K) ? load1h(1u, boff + nn * p.ldb + kk) : 0.0);
                }
            }
        }
#else
        // B (K×N): 每 k 行 n 连续 4 → 2 uint 整写
        for (int r = 0; r < 4; r++) {
            uint kk = bk + r;
            uint e = boff + kk * p.ldb + bn;
            if (kk < p.K && bn + 3 < p.N && (e & 1u) == 0u) {
                uvec2 u = load4h(1u, e);
                Bs[k0 + r][n0 >> 1] = u.x;        // half n0, n0+1
                Bs[k0 + r][(n0 >> 1) + 1] = u.y;  // half n0+2, n0+3
            } else {
                for (int c = 0; c < 4; c++) {
                    uint nn = bn + uint(c);
                    put_bs(kk, nn, (kk < p.K && nn < p.N) ? load1h(1u, boff + kk * p.ldb + nn) : 0.0);
                }
            }
        }
#endif
    }
}

void main() {
    uint tgx = gl_WorkGroupID.x % p.Mt;
    uint b = gl_WorkGroupID.x / p.Mt;
    uint tgy = gl_WorkGroupID.y;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    uint base_m = tgx * 128, base_n = tgy * 128;

    float acc[8][8];
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 8; j++)
            acc[i][j] = 0.0;

    load_tile(0);
    barrier();

    for (uint kt = 0; kt < p.Kt; kt++) {
        for (int kk = 0; kk < 16; kk++) {
#if HALF_TYPE == 2
            // bf16 打包: 每 kk 4 条 b64 (A 2 + B 2), 每 b64 = 4 half; 位模式直通, 无 cvt
            // 布局: 线程 lx/ly 的 8 half = [lx*8 .. lx*8+8) (连续), 2 条 b64 @ lx*4 (+2)
            // bank: lx*4 %32 = {0,4,..28} × 2 uint (b64) = 32 bank 全唯一 → 无冲突
            float arow[8], brow[8];
            for (int ii = 0; ii < 2; ii++) {
                uint au0 = As[kk][lx * 4 + ii * 2];
                uint au1 = As[kk][lx * 4 + ii * 2 + 1];
                uint bu0 = Bs[kk][ly * 4 + ii * 2];
                uint bu1 = Bs[kk][ly * 4 + ii * 2 + 1];
                int o = ii * 4;
                arow[o + 0] = uintBitsToFloat((au0 & 0xFFFFu) << 16u);
                arow[o + 1] = uintBitsToFloat(au0 & 0xFFFF0000u);
                arow[o + 2] = uintBitsToFloat((au1 & 0xFFFFu) << 16u);
                arow[o + 3] = uintBitsToFloat(au1 & 0xFFFF0000u);
                brow[o + 0] = uintBitsToFloat((bu0 & 0xFFFFu) << 16u);
                brow[o + 1] = uintBitsToFloat(bu0 & 0xFFFF0000u);
                brow[o + 2] = uintBitsToFloat((bu1 & 0xFFFFu) << 16u);
                brow[o + 3] = uintBitsToFloat(bu1 & 0xFFFF0000u);
            }
#else
            // fp16: 4 条 b64 + v_cvt 展开 (布局同上)
            float arow[8], brow[8];
            for (int ii = 0; ii < 2; ii++) {
                uvec2 au = uvec2(As[kk][lx * 4 + ii * 2], As[kk][lx * 4 + ii * 2 + 1]);
                uvec2 bu = uvec2(Bs[kk][ly * 4 + ii * 2], Bs[kk][ly * 4 + ii * 2 + 1]);
                int o = ii * 4;
                vec2 ax = unpackHalf2x16(au.x), ay = unpackHalf2x16(au.y);
                vec2 bx = unpackHalf2x16(bu.x), by = unpackHalf2x16(bu.y);
                arow[o + 0] = ax.x; arow[o + 1] = ax.y;
                arow[o + 2] = ay.x; arow[o + 3] = ay.y;
                brow[o + 0] = bx.x; brow[o + 1] = bx.y;
                brow[o + 2] = by.x; brow[o + 3] = by.y;
            }
#endif
            for (int i = 0; i < 8; i++)
                for (int j = 0; j < 8; j++)
                    acc[i][j] += arow[i] * brow[j];
        }
        barrier();
        if (kt + 1 < p.Kt) {
            load_tile(kt + 1);
            barrier();
        }
    }

    // 写 C (与 v9h 相同)
    uint coff = b * p.batch_stride_c;
    for (int ii = 0; ii < 4; ii++) {
        uint row = base_m + lx * 2 + ii * 32;
        for (int c = 0; c < 2; c++, row++) {
            if (row >= p.M) continue;
            uint cbase = base_n + ly * 2;
            if (cbase >= p.N) continue;
            for (int jj = 0; jj < 4; jj++) {
                for (int d = 0; d < 2; d += 2) {
                    uint cc = cbase + jj * 32;
                    if (cc + 1 >= p.N) continue;
                    uint e = coff + row * p.ldc + cc;
                    float c0, c1;
                    if (p.beta != 0.0) {
                        uint old = C[e >> 1];
                        c0 = p.alpha * acc[ii * 2 + c][jj * 2 + d] + p.beta * hx(old, 0u);
                        c1 = p.alpha * acc[ii * 2 + c][jj * 2 + d + 1] + p.beta * hx(old, 1u);
                    } else {
                        c0 = p.alpha * acc[ii * 2 + c][jj * 2 + d];
                        c1 = p.alpha * acc[ii * 2 + c][jj * 2 + d + 1];
                    }
                    C[e >> 1] = f2h(c0) | (f2h(c1) << 16u);
                }
            }
        }
    }
}