#version 450
// GEMM f16/bf16 128x256 bankfree (高 acc 密度实验变体): tile 128×256 (M×N), BK=16, 256 线程 (16×16),
// 每线程 8×16 = 128 acc —— 主循环 FMA:LDS = 128:12 ≈ 10.7 (128x128 版为 8:1)。
// 动机 (10-10 夜): st-even-huge K=40 低效分解显示每 WG "K 无关底噪"占 ~88%, 假设 = 主循环
// LDS 读吞吐压制 → 提高每线程计算密度拉高 FMA:LDS 比。
// = gemm_half_128x128_bankfree_tmpl.comp 的 N 方向加倍版 (逐行同构, 仅 N 相关量 ×2):
//   Bs 行步长 258 (256+2); brow 每 kk 16 元素 (8 vec2); 写 C 每线程 8 行 × 16 列。
// A/B/C 为 2B 半精度位模式 (uint 数组); -D HALF_TYPE=1 (fp16) / 2 (bf16); -D TA/TB 同 bankfree
// host 保证: ldc 偶 且 N 偶 → 无跨行共享 uint; 转置 B 行步长 pad 偶
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer A_buf { uint A[]; };
layout(set = 0, binding = 1) buffer B_buf { uint B[]; };
layout(set = 0, binding = 2) buffer C_buf { uint C[]; };

layout(push_constant) uniform Params {
    uint M, N, K;
    uint Mt, Nt, Kt;
    uint lda, ldb, ldc;
    uint batch_stride_a, batch_stride_b, batch_stride_c;
    float alpha, beta;
} p;

shared float As[16][130];
shared float Bs[16][258];

// ---- 半精度位操作 (同 bankfree) ----
float hx(uint u, uint hb) {
#if HALF_TYPE == 1
    return unpackHalf2x16(u)[hb];
#else
    return uintBitsToFloat(((u >> (hb * 16u)) & 0xFFFFu) << 16u);
#endif
}
vec2 hx2(uint u) {
#if HALF_TYPE == 1
    return unpackHalf2x16(u);
#else
    return vec2(uintBitsToFloat((u & 0xFFFFu) << 16u),
                uintBitsToFloat(u & 0xFFFF0000u));
#endif
}
uint f2h(float v) {
#if HALF_TYPE == 1
    return packHalf2x16(vec2(v, 0.0)) & 0xFFFFu;
#else
    uint u = floatBitsToUint(v);
    return ((u + 0x7FFFu + ((u >> 16) & 1u)) >> 16) & 0xFFFFu;   // RNE
#endif
}
float load1(uint e, int b) {
    uint u = (b == 0 ? A[e >> 1] : B[e >> 1]);
    return hx(u, e & 1u);
}
vec2 load2(uint e, int b) {
    if ((e & 1u) == 0u) return hx2(b == 0 ? A[e >> 1] : B[e >> 1]);
    uint u0 = (b == 0 ? A[e >> 1] : B[e >> 1]);
    uint u1 = (b == 0 ? A[(e >> 1) + 1u] : B[(e >> 1) + 1u]);
    return vec2(hx(u0, 1u), hx(u1, 0u));
}
vec4 load4(uint e, int b) {
    if ((e & 1u) == 0u) {
        uint u0 = (b == 0 ? A[e >> 1] : B[e >> 1]);
        uint u1 = (b == 0 ? A[(e >> 1) + 1u] : B[(e >> 1) + 1u]);
        return vec4(hx2(u0), hx2(u1));
    }
    uint u0 = (b == 0 ? A[e >> 1] : B[e >> 1]);
    uint u1 = (b == 0 ? A[(e >> 1) + 1u] : B[(e >> 1) + 1u]);
    uint u2 = (b == 0 ? A[(e >> 1) + 2u] : B[(e >> 1) + 2u]);
    return vec4(hx(u0, 1u), hx(u1, 0u), hx(u1, 1u), hx(u2, 0u));
}

void load_tile(uint kt) {
    uint base_k = kt * 16;
    uint b = gl_WorkGroupID.x / p.Mt;                 // batch 索引 (x 轴: z>16 串行, x 无限制)
    uint tgx = gl_WorkGroupID.x % p.Mt;
    uint base_m = tgx * 128;
    uint base_n = gl_WorkGroupID.y * 256;             // 128x256: N 方向 256
    uint tid = gl_LocalInvocationID.y * 16 + gl_LocalInvocationID.x;
    uint aoff = b * p.batch_stride_a;                 // batch 元素偏移
    uint boff = b * p.batch_stride_b;

    // A: 128×16 tile = 2048 元素, tid<128 加载, 每线程 4 m × 4 k (同 128x128 版)
    if (tid < 128) {
        uint m0 = (tid % 32) * 4;
        uint k0 = (tid / 32) * 4;
        uint am = base_m + m0;
        uint ak = base_k + k0;
#if TA == 1
        // A 是 (K×M): A_eff[m][k] = A[k*lda+m], m 连续 4
        for (int r = 0; r < 4; r++) {
            uint kk = ak + r;
            if (kk < p.K && am + 3 < p.M) {
                vec4 v = load4(aoff + kk * p.lda + am, 0);
                As[k0 + r][m0 + 0] = v.x; As[k0 + r][m0 + 1] = v.y;
                As[k0 + r][m0 + 2] = v.z; As[k0 + r][m0 + 3] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint mm = am + uint(c);
                    As[k0 + r][m0 + c] = (kk < p.K && mm < p.M) ? load1(aoff + kk * p.lda + mm, 0) : 0.0;
                }
            }
        }
#else
        // A 是 (M×K): A_eff[m][k] = A[m*lda+k], k 连续 4
        uint kq = tid & 3u;
        uint m4 = tid >> 2;
        uint ak4 = kq * 4;                       // 本线程 k 段 (局部 0..15)
        for (int r = 0; r < 4; r++) {
            uint ml = m4 + uint(r) * 32;         // As 列 (tile 局部 0..127)
            uint mm = base_m + ml;               // 全局行 (读用)
            if (mm < p.M && base_k + ak4 + 3 < p.K) {
                vec4 v = load4(aoff + mm * p.lda + base_k + ak4, 0);
                As[ak4 + 0][ml] = v.x; As[ak4 + 1][ml] = v.y;
                As[ak4 + 2][ml] = v.z; As[ak4 + 3][ml] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = base_k + ak4 + uint(c);
                    As[ak4 + uint(c)][ml] = (mm < p.M && kk < p.K) ? load1(aoff + mm * p.lda + kk, 0) : 0.0;
                }
            }
        }
#endif
    } else {
        // B: 16×256 tile (K×N) = 4096 元素, tid>=128 (128 线程), 每线程 8 n × 4 k
        uint t2 = tid - 128;
        uint n0 = (t2 % 32) * 8;                 // 128x256: 32 线程盖 256 列
        uint k0 = (t2 / 32) * 4;
        uint bn = base_n + n0;
        uint bk = base_k + k0;
#if TB == 1
        // B 是 (N×K): B_eff[k][n] = B[n*ldb+k], k 连续 4
        for (int r = 0; r < 8; r++) {            // 8 个 n
            uint nn = bn + r;
            if (nn < p.N && bk + 3 < p.K) {
                vec4 v = load4(boff + nn * p.ldb + bk, 1);
                Bs[k0 + 0][n0 + r] = v.x; Bs[k0 + 1][n0 + r] = v.y;
                Bs[k0 + 2][n0 + r] = v.z; Bs[k0 + 3][n0 + r] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = bk + uint(c);
                    Bs[k0 + c][n0 + r] = (nn < p.N && kk < p.K) ? load1(boff + nn * p.ldb + kk, 1) : 0.0;
                }
            }
        }
#else
        // B 是 (K×N): B_eff[k][n] = B[k*ldb+n], n 连续 8 (2×vec4)
        for (int r = 0; r < 4; r++) {
            uint kk = bk + r;
            if (kk < p.K && bn + 7 < p.N) {
                vec4 v = load4(boff + kk * p.ldb + bn, 1);
                Bs[k0 + r][n0 + 0] = v.x; Bs[k0 + r][n0 + 1] = v.y;
                Bs[k0 + r][n0 + 2] = v.z; Bs[k0 + r][n0 + 3] = v.w;
                vec4 w = load4(boff + kk * p.ldb + bn + 4u, 1);
                Bs[k0 + r][n0 + 4] = w.x; Bs[k0 + r][n0 + 5] = w.y;
                Bs[k0 + r][n0 + 6] = w.z; Bs[k0 + r][n0 + 7] = w.w;
            } else {
                for (int c = 0; c < 8; c++) {
                    uint nn = bn + uint(c);
                    Bs[k0 + r][n0 + c] = (kk < p.K && nn < p.N) ? load1(boff + kk * p.ldb + nn, 1) : 0.0;
                }
            }
        }
#endif
    }
}

void main() {
    uint tgx = gl_WorkGroupID.x % p.Mt;              // tile m (batch 已并入 x 轴)
    uint b = gl_WorkGroupID.x / p.Mt;
    uint tgy = gl_WorkGroupID.y;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    uint base_m = tgx * 128, base_n = tgy * 256;

    float acc[8][16];
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 16; j++)
            acc[i][j] = 0.0;

    load_tile(0);
    barrier();

    for (uint kt = 0; kt < p.Kt; kt++) {
        for (int kk = 0; kk < 16; kk++) {
            // 无冲突 vec2 读 (v9 布局): arow[i]=As[kk][lx*2+ii*32+c], brow[j]=Bs[kk][ly*2+jj*32+d]
            float arow[8], brow[16];
            for (int ii = 0; ii < 4; ii++) {
                vec2 a = vec2(As[kk][lx * 2 + ii * 32], As[kk][lx * 2 + ii * 32 + 1]);
                arow[ii * 2 + 0] = a.x; arow[ii * 2 + 1] = a.y;
            }
            for (int jj = 0; jj < 8; jj++) {
                vec2 bv = vec2(Bs[kk][ly * 2 + jj * 32], Bs[kk][ly * 2 + jj * 32 + 1]);
                brow[jj * 2 + 0] = bv.x; brow[jj * 2 + 1] = bv.y;
            }
            for (int i = 0; i < 8; i++)
                for (int j = 0; j < 16; j++)
                    acc[i][j] += arow[i] * brow[j];
        }
        barrier();
        if (kt + 1 < p.Kt) {
            load_tile(kt + 1);
            barrier();
        }
    }

    // 写 C: 每线程 8 行 × 16 列, 列组 jj=0..7 (与主循环 brow 段一致)
    uint coff = b * p.batch_stride_c;
    for (int ii = 0; ii < 4; ii++) {
        uint row = base_m + lx * 2 + ii * 32;
        for (int c = 0; c < 2; c++, row++) {
            if (row >= p.M) continue;
            uint cbase = base_n + ly * 2;
            if (cbase >= p.N) continue;
            for (int jj = 0; jj < 8; jj++) {
                for (int d = 0; d < 2; d += 2) {
                    uint cc = cbase + jj * 32;
                    if (cc + 1 >= p.N) continue;
                    uint e = coff + row * p.ldc + cc;
                    float c0, c1;
                    if (p.beta != 0.0) {
                        vec2 old = hx2(C[e >> 1]);
                        c0 = p.alpha * acc[ii * 2 + c][jj * 2 + d] + p.beta * old.x;
                        c1 = p.alpha * acc[ii * 2 + c][jj * 2 + d + 1] + p.beta * old.y;
                    } else {
                        c0 = p.alpha * acc[ii * 2 + c][jj * 2 + d];
                        c1 = p.alpha * acc[ii * 2 + c][jj * 2 + d + 1];
                    }
                    C[e >> 1] = f2h(c0) | (f2h(c1) << 16u);
                }
            }
        }
    }
}