#version 450
// matvec v2: C(M=1, N) = A(1, K) · B, decode 专用
// 消除 M=1 GEMM 的 B 全量转置 (64MB 读写浪费): B 直接合并读
// 变体宏:
//   TB=0: B 是 (K×N) row-major, B_eff[k][n] = B[k*ldb+n]: 每线程 MV_COLS 列连续读
//   TB=1: B 是 (N×K) row-major, B_eff[k][n] = B[n*ldb+k]: 每线程 1 列, vec4 读 k
// A[k] 每线程读 (同 wg 内广播, L2 命中)
#ifndef MV_COLS
#define MV_COLS 4
#endif
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer A_buf { float A[]; };
layout(set = 0, binding = 1) buffer B_buf { float B[]; };
layout(set = 0, binding = 2) buffer C_buf { float C[]; };

layout(push_constant) uniform Params {
    uint K, N;
    uint ldb, ldc;
    float alpha, beta;
} p;

void main() {
    uint tid = gl_LocalInvocationIndex;
    uint n0 = gl_WorkGroupID.x * (256u * MV_COLS);

#if TB == 0
    // B 是 (K×N): 每线程 MV_COLS 列, 每 k 读 MV_COLS 个连续 n (合并)
    uint j0 = n0 + tid * MV_COLS;
    float acc[MV_COLS];
    for (int i = 0; i < MV_COLS; i++) acc[i] = 0.0;
    if (j0 + MV_COLS - 1 < p.N) {
        for (uint k = 0; k < p.K; k++) {
            float a = A[k];
            uint base = k * p.ldb + j0;
            for (int i = 0; i < MV_COLS; i++) acc[i] += a * B[base + i];
        }
        for (int i = 0; i < MV_COLS; i++) {
            uint j = j0 + uint(i);
            float c = (p.beta != 0.0) ? C[j] : 0.0;
            C[j] = p.alpha * acc[i] + p.beta * c;
        }
    } else {
        for (uint k = 0; k < p.K; k++) {
            float a = A[k];
            for (int i = 0; i < MV_COLS; i++) {
                uint j = j0 + uint(i);
                if (j < p.N) acc[i] += a * B[k * p.ldb + j];
            }
        }
        for (int i = 0; i < MV_COLS; i++) {
            uint j = j0 + uint(i);
            if (j < p.N) {
                float c = (p.beta != 0.0) ? C[j] : 0.0;
                C[j] = p.alpha * acc[i] + p.beta * c;
            }
        }
    }
#else
    // B 是 (N×K): 每线程 1 列, vec4 读 k (合并)
    uint j = n0 + tid;
    if (j < p.N) {
        float acc = 0.0;
        uint k = 0;
        for (; k + 4 <= p.K; k += 4) {
            uint base = j * p.ldb + k;
            acc += A[k] * B[base + 0] + A[k + 1] * B[base + 1] +
                   A[k + 2] * B[base + 2] + A[k + 3] * B[base + 3];
        }
        for (; k < p.K; k++) acc += A[k] * B[j * p.ldb + k];
        float c = (p.beta != 0.0) ? C[j] : 0.0;
        C[j] = p.alpha * acc + p.beta * c;
    }
#endif
}