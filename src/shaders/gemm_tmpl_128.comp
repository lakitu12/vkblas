#version 450
// GEMM f32 v7-128: tile 128×128 (M×N), BK=16, 256 线程 (16×16), 每线程 8×8 = 64 累加器
// 设计来源: llama.cpp mul_mm.comp l_warptile 思想 (128×128 tile, BK16, 高 acc/线程)
// 修正 v1 错误: 输出数必须自洽 (128×128/256 = 64/线程), B 加载与主循环映射一致
// 与 v6 差异:
//   - 每线程 64 acc (v6: 16) → LDS 读 1.5B/FMA (v6: 2B/FMA), LDS 压力降 25%
//   - 写 C: 每线程 8 连续列 (32B); wave 覆盖 128 行×32 列 (v6: 16 行) → 写 C 行数 8 倍
//   - LDS: As[16][130]+Bs[16][130] = 16.6KB → 3 wg/CU = 12 wave (与 v6 同占用)
//   - 加载: A/B 各 128 线程 (tid<128 加载 A, >=128 加载 B), 每线程 4m×4k vec4 读
// LDS 行步长 130 (128+2, ≡2 mod 32): bank 16 组 2 路冲突, b64 安全 (130*4=520 ≡ 8 mod 16, 不能 b128)
// 编译期宏 TA/TB
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer A_buf { float A[]; };
layout(set = 0, binding = 1) buffer B_buf { float B[]; };
layout(set = 0, binding = 2) buffer C_buf { float C[]; };

layout(push_constant) uniform Params {
    uint M, N, K;
    uint Mt, Nt, Kt;
    uint lda, ldb, ldc;
    float alpha, beta;
} p;

// As[k][m]: k 16 行 × m 128 列, 行步长 130 (128+2)
// Bs[k][n]: k 16 行 × n 128 列, 行步长 130
shared float As[16][130];
shared float Bs[16][130];

void load_tile(uint kt) {
    uint base_k = kt * 16;
    uint base_m = gl_WorkGroupID.x * 128;
    uint base_n = gl_WorkGroupID.y * 128;
    uint tid = gl_LocalInvocationID.y * 16 + gl_LocalInvocationID.x;

    // A: 128×16 tile = 2048 元素, tid<128 加载 (128 线程 × 16 = 2048)
    // 每线程 4 m × 4 k, vec4 读 k 连续
    // m 组 32 (tid%32 每线程 4 m = 128), k 组 4 (tid/32 每线程 4 k = 16)
    if (tid < 128) {
        uint m0 = (tid % 32) * 4;
        uint k0 = (tid / 32) * 4;
        uint am = base_m + m0;
        uint ak = base_k + k0;
#if TA == 1
        // A 是 (K×M): A_eff[m][k] = A[k*lda+m], m 连续 4 → vec4, As[k][m] 直接存
        for (int r = 0; r < 4; r++) {
            uint kk = ak + r;
            if (kk < p.K && am + 3 < p.M) {
                vec4 v = vec4(A[kk * p.lda + am], A[kk * p.lda + am + 1],
                              A[kk * p.lda + am + 2], A[kk * p.lda + am + 3]);
                As[k0 + r][m0 + 0] = v.x; As[k0 + r][m0 + 1] = v.y;
                As[k0 + r][m0 + 2] = v.z; As[k0 + r][m0 + 3] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint mm = am + uint(c);
                    As[k0 + r][m0 + c] = (kk < p.K && mm < p.M) ? A[kk * p.lda + mm] : 0.0;
                }
            }
        }
#else
        // A 是 (M×K): A_eff[m][k] = A[m*lda+k], k 连续 4 → vec4, As[k][m] 转置存
        for (int r = 0; r < 4; r++) {
            uint mm = am + r;
            if (mm < p.M && ak + 3 < p.K) {
                vec4 v = vec4(A[mm * p.lda + ak], A[mm * p.lda + ak + 1],
                              A[mm * p.lda + ak + 2], A[mm * p.lda + ak + 3]);
                As[k0 + 0][m0 + r] = v.x; As[k0 + 1][m0 + r] = v.y;
                As[k0 + 2][m0 + r] = v.z; As[k0 + 3][m0 + r] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = ak + uint(c);
                    As[k0 + c][m0 + r] = (mm < p.M && kk < p.K) ? A[mm * p.lda + kk] : 0.0;
                }
            }
        }
#endif
    } else {
        // B: 16×128 tile (K×N) = 2048 元素, tid>=128 加载
        // 每线程 4 n × 4 k, vec4 读 n 连续
        uint t2 = tid - 128;
        uint n0 = (t2 % 32) * 4;
        uint k0 = (t2 / 32) * 4;
        uint bn = base_n + n0;
        uint bk = base_k + k0;
#if TB == 1
        // B 是 (N×K): B_eff[k][n] = B[n*ldb+k], k 连续 4 → vec4, Bs[k][n] 转置存
        for (int r = 0; r < 4; r++) {
            uint nn = bn + r;
            if (nn < p.N && bk + 3 < p.K) {
                vec4 v = vec4(B[nn * p.ldb + bk], B[nn * p.ldb + bk + 1],
                              B[nn * p.ldb + bk + 2], B[nn * p.ldb + bk + 3]);
                Bs[k0 + 0][n0 + r] = v.x; Bs[k0 + 1][n0 + r] = v.y;
                Bs[k0 + 2][n0 + r] = v.z; Bs[k0 + 3][n0 + r] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = bk + uint(c);
                    Bs[k0 + c][n0 + r] = (nn < p.N && kk < p.K) ? B[nn * p.ldb + kk] : 0.0;
                }
            }
        }
#else
        // B 是 (K×N): B_eff[k][n] = B[k*ldb+n], n 连续 4 → vec4, Bs[k][n] 直接存
        for (int r = 0; r < 4; r++) {
            uint kk = bk + r;
            if (kk < p.K && bn + 3 < p.N) {
                vec4 v = vec4(B[kk * p.ldb + bn], B[kk * p.ldb + bn + 1],
                              B[kk * p.ldb + bn + 2], B[kk * p.ldb + bn + 3]);
                Bs[k0 + r][n0 + 0] = v.x; Bs[k0 + r][n0 + 1] = v.y;
                Bs[k0 + r][n0 + 2] = v.z; Bs[k0 + r][n0 + 3] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint nn = bn + uint(c);
                    Bs[k0 + r][n0 + c] = (kk < p.K && nn < p.N) ? B[kk * p.ldb + nn] : 0.0;
                }
            }
        }
#endif
    }
}

void main() {
    uint tgx = gl_WorkGroupID.x, tgy = gl_WorkGroupID.y;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    uint base_m = tgx * 128, base_n = tgy * 128;

    float acc[8][8];
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 8; j++)
            acc[i][j] = 0.0;

    load_tile(0);
    barrier();

    for (uint kt = 0; kt < p.Kt; kt++) {
        for (int kk = 0; kk < 16; kk++) {
            // 8×b64 LDS 读 (16 floats) + 64 FMA → 1.5B/FMA (v6: 2B/FMA)
            float arow[8], brow[8];
            for (int i = 0; i < 8; i++) arow[i] = As[kk][lx * 8 + i];
            for (int j = 0; j < 8; j++) brow[j] = Bs[kk][ly * 8 + j];
            for (int i = 0; i < 8; i++)
                for (int j = 0; j < 8; j++)
                    acc[i][j] += arow[i] * brow[j];
        }
        barrier();
        if (kt + 1 < p.Kt) {
            load_tile(kt + 1);
            barrier();
        }
    }

    // 写 C: 每线程 8 行 × 8 列 (32B 连续); wave 内覆盖全部 128 行 × 32 列
    for (int i = 0; i < 8; i++) {
        uint row = base_m + lx * 8 + i;
        if (row >= p.M) continue;
        uint cbase = base_n + ly * 8;
        if (cbase >= p.N) continue;
        for (int j = 0; j < 8; j++) {
            uint col = cbase + j;
            if (col < p.N) {
                float cval = (p.beta != 0.0) ? C[row * p.ldc + col] : 0.0;
                C[row * p.ldc + col] = p.alpha * acc[i][j] + p.beta * cval;
            }
        }
    }
}
