#version 450
// GEMM f32 v7-128 + split-k: tile 128×128 (同 gemm_tmpl_128.comp), K 分段并行
// dispatch x = Mt × split_k; ik = wgx / Mt; 输出纯部分和 → Sk[ik*M*N + m*N + n]
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer A_buf { float A[]; };
layout(set = 0, binding = 1) buffer B_buf { float B[]; };
layout(set = 0, binding = 2) buffer Sk_buf { float Sk[]; };

layout(push_constant) uniform Params {
    uint M, N, K;
    uint Mt, Nt, Kt;
    uint lda, ldb, ldc;
    float alpha, beta;
    uint k_split;
} p;

shared float As[16][130];
shared float Bs[16][130];

void load_tile(uint kt, uint tgx) {
    uint base_k = kt * 16;
    uint base_m = tgx * 128;
    uint base_n = gl_WorkGroupID.y * 128;
    uint tid = gl_LocalInvocationID.y * 16 + gl_LocalInvocationID.x;

    if (tid < 128) {
        uint m0 = (tid % 32) * 4;
        uint k0 = (tid / 32) * 4;
        uint am = base_m + m0;
        uint ak = base_k + k0;
#if TA == 1
        for (int r = 0; r < 4; r++) {
            uint kk = ak + r;
            if (kk < p.K && am + 3 < p.M) {
                vec4 v = vec4(A[kk * p.lda + am], A[kk * p.lda + am + 1],
                              A[kk * p.lda + am + 2], A[kk * p.lda + am + 3]);
                As[k0 + r][m0 + 0] = v.x; As[k0 + r][m0 + 1] = v.y;
                As[k0 + r][m0 + 2] = v.z; As[k0 + r][m0 + 3] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint mm = am + uint(c);
                    As[k0 + r][m0 + c] = (kk < p.K && mm < p.M) ? A[kk * p.lda + mm] : 0.0;
                }
            }
        }
#else
        for (int r = 0; r < 4; r++) {
            uint mm = am + r;
            if (mm < p.M && ak + 3 < p.K) {
                vec4 v = vec4(A[mm * p.lda + ak], A[mm * p.lda + ak + 1],
                              A[mm * p.lda + ak + 2], A[mm * p.lda + ak + 3]);
                As[k0 + 0][m0 + r] = v.x; As[k0 + 1][m0 + r] = v.y;
                As[k0 + 2][m0 + r] = v.z; As[k0 + 3][m0 + r] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = ak + uint(c);
                    As[k0 + c][m0 + r] = (mm < p.M && kk < p.K) ? A[mm * p.lda + kk] : 0.0;
                }
            }
        }
#endif
    } else {
        uint t2 = tid - 128;
        uint n0 = (t2 % 32) * 4;
        uint k0 = (t2 / 32) * 4;
        uint bn = base_n + n0;
        uint bk = base_k + k0;
#if TB == 1
        for (int r = 0; r < 4; r++) {
            uint nn = bn + r;
            if (nn < p.N && bk + 3 < p.K) {
                vec4 v = vec4(B[nn * p.ldb + bk], B[nn * p.ldb + bk + 1],
                              B[nn * p.ldb + bk + 2], B[nn * p.ldb + bk + 3]);
                Bs[k0 + 0][n0 + r] = v.x; Bs[k0 + 1][n0 + r] = v.y;
                Bs[k0 + 2][n0 + r] = v.z; Bs[k0 + 3][n0 + r] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint kk = bk + uint(c);
                    Bs[k0 + c][n0 + r] = (nn < p.N && kk < p.K) ? B[nn * p.ldb + kk] : 0.0;
                }
            }
        }
#else
        for (int r = 0; r < 4; r++) {
            uint kk = bk + r;
            if (kk < p.K && bn + 3 < p.N) {
                vec4 v = vec4(B[kk * p.ldb + bn], B[kk * p.ldb + bn + 1],
                              B[kk * p.ldb + bn + 2], B[kk * p.ldb + bn + 3]);
                Bs[k0 + r][n0 + 0] = v.x; Bs[k0 + r][n0 + 1] = v.y;
                Bs[k0 + r][n0 + 2] = v.z; Bs[k0 + r][n0 + 3] = v.w;
            } else {
                for (int c = 0; c < 4; c++) {
                    uint nn = bn + uint(c);
                    Bs[k0 + r][n0 + c] = (kk < p.K && nn < p.N) ? B[kk * p.ldb + nn] : 0.0;
                }
            }
        }
#endif
    }
}

void main() {
    // split-k 解算: dispatch x = Mt × split_k, ik = wgx / Mt, tgx = wgx % Mt
    uint ik = gl_WorkGroupID.x / p.Mt;
    uint tgx = gl_WorkGroupID.x % p.Mt;
    uint start_k = ik * p.k_split;
    uint end_k = min(p.K, (ik + 1) * p.k_split);

    uint tgy = gl_WorkGroupID.y;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    uint base_m = tgx * 128, base_n = tgy * 128;

    float acc[8][8];
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 8; j++)
            acc[i][j] = 0.0;

    uint start_kt = start_k / 16;
    uint end_kt = (end_k + 15) / 16;

    load_tile(start_kt, tgx);
    barrier();

    for (uint kt = start_kt; kt < end_kt; kt++) {
        for (int kk = 0; kk < 16; kk++) {
            float arow[8], brow[8];
            for (int i = 0; i < 8; i++) arow[i] = As[kk][lx * 8 + i];
            for (int j = 0; j < 8; j++) brow[j] = Bs[kk][ly * 8 + j];
            for (int i = 0; i < 8; i++)
                for (int j = 0; j < 8; j++)
                    acc[i][j] += arow[i] * brow[j];
        }
        barrier();
        if (kt + 1 < end_kt) {
            load_tile(kt + 1, tgx);
            barrier();
        }
    }

    // 输出纯部分和 (alpha/beta 由 reduce 处理)
    uint base_sk = ik * p.M * p.N;
    for (int i = 0; i < 8; i++) {
        uint row = base_m + lx * 8 + i;
        if (row >= p.M) continue;
        uint cbase = base_n + ly * 8;
        if (cbase >= p.N) continue;
        for (int j = 0; j < 8; j++) {
            uint col = cbase + j;
            if (col < p.N)
                Sk[base_sk + row * p.N + col] = acc[i][j];
        }
    }
}
