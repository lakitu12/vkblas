#version 450
// transpose f64: In (R×C row-major, ldin) → Out (C×R row-major, ldout)
// fp64 GEMM 的 B 快路径 (TB=0 → 转置走 TB=1); 标量访问 (dvec2 需 16B 对齐)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer In_buf { double In[]; };
layout(set = 0, binding = 1) buffer Out_buf { double Out[]; };
layout(push_constant) uniform Params {
    uint R, C;
    uint ldin;
    uint ldout;
    uint roff;
} p;

void main() {
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    uint tid = ly * 16 + lx;
    // 每块覆盖 16 行 (tid>>4 = ly ∈ [0,16)) × 32 列 (每线程 2 列, 16 线程)
    uint br = p.roff + gl_WorkGroupID.x * 16;
    uint bc = gl_WorkGroupID.y * 32;

    uint r = br + (tid >> 4);
    uint c = bc + (tid & 15) * 2;
    if (r < p.R && c + 1 < p.C) {
        double v0 = In[r * p.ldin + c];
        double v1 = In[r * p.ldin + c + 1];
        Out[c * p.ldout + r] = v0;
        Out[(c + 1) * p.ldout + r] = v1;
    } else {
        for (int i = 0; i < 2; i++) {
            uint cc = c + uint(i);
            if (r < p.R && cc < p.C)
                Out[cc * p.ldout + r] = In[r * p.ldin + cc];
        }
    }
}
